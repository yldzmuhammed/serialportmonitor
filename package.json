{
  "name": "serial-port-monitor",
  "version": "1.0.0",
  "description": "Cross-platform serial port monitor (macOS, Windows, Linux)",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electronmon .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux"
  },
  "author": "yldzmuhammed",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "electronmon": "^2.0.4"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "serialport": "^12.0.0",
    "zod": "^3.25.76"
  },
  "build": {
    "appId": "com.ameza.serialportmonitor",
    "productName": "Serial Port Monitor",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  }
}
